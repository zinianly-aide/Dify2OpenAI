{
  "name": "dsh-dify-provider",
  "version": "0.1.0",
  "description": "Native DSH LLM adapter for Dify chat applications with session-aware conversation lifecycle",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
